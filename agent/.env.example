# ── Copy to agent/.env (gitignored). Never commit real values. ───────────────

# Landing page event store (Netlify function /api/report)
SITE_URL=https://debtdirectsolutions.com
REPORT_TOKEN=change-me-long-random-string

# Meta Marketing API — system user token with ads_management on the ad account
META_TOKEN=
META_AD_ACCOUNT_ID=act_276922883   # optional here; also set in config.yml
META_API_VERSION=v26.0

# Claude API (weekly review, social content generation)
ANTHROPIC_API_KEY=

# Where the daily digest goes. Leave empty to just print + write to reports/.
RESEND_API_KEY=
DIGEST_TO=you@example.com
DIGEST_FROM=digest@debtdirectsolutions.com

# Social publishing (Instagram Graph API + Facebook Page)
IG_USER_ID=
FB_PAGE_ID=
FB_PAGE_TOKEN=
